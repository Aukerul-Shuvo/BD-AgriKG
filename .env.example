# Copy this file to .env and fill in your AWS credentials for Bedrock.
# .env is gitignored and is never read by Claude, only by the harness at
# runtime through python-dotenv / boto3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# only needed for temporary/SSO credentials:
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
